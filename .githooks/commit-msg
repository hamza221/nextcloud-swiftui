# Conventional Commits check, for local convenience only. CI gates the PR title,
# because squash-merge makes the PR title the commit subject. Deliberately a
# plain shell script: an npm toolchain (husky/commitlint) has no place in a
# Swift repo.

msg_file="$1"
subject=$(sed -n '1p' "$msg_file")

# Let merge, revert and fixup commits through untouched.
case "$subject" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,}'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
    cat >&2 <<'MSG'
Commit subject is not a Conventional Commit.

  <type>[(scope)][!]: <description>

Types:  feat fix docs style refactor perf test build ci chore revert
Scopes: design, icons, platform, ui, showcase, docs, ci, or a component
        name such as avatar or list-item.

Examples:
  feat(design): add NCDynamicColor with a ShapeStyle conformance
  fix(avatar): fall back to initials when the loader throws
MSG
    exit 1
fi

if [ "${#subject}" -gt 72 ]; then
    echo "Commit subject is ${#subject} characters; keep it under 72." >&2
    exit 1
fi
